# gdlint configuration for Pear Pudding TCG
# Install via: pip install gdtoolkit
# Run via:     gdlint **/*.gd
# Docs:        https://github.com/Scony/godot-gdscript-toolkit

max-line-length: 120
max-file-lines: 500
max-public-methods: 30

# BID-053: mixed-tabs-and-spaces is a false positive for this codebase's
# style. Every flagged line is a bracket-continuation alignment inside an
# open array/dict literal (tab-indented statement, spaces used only to
# visually align a wrapped element or trailing comment) — not a genuine
# indentation ambiguity. GDScript's indentation sensitivity applies to a
# statement's leading indentation; these are continuations inside an open
# bracket, and Godot parses them correctly (the test suite is green).
# Investigated line-by-line in tasks/backlog/BID-053; see its Progress
# section for the count and rationale.
disable: [mixed-tabs-and-spaces]

# Naming convention regexes matching GDScript community standard.
#
# snake_case with optional leading underscore (private).  Digits are allowed
# anywhere after the first character, e.g. test_health_is_30.
function-name: "_?[a-z][a-z0-9_]*"
class-name: "[A-Z][a-zA-Z0-9]*"
sub-class-name: "[A-Z][a-zA-Z0-9]*"
signal-name: "[a-z][a-z0-9_]*"
class-variable-name: "_?[a-z][a-z0-9_]*"

# Preloaded/loaded class-scope vars may be private snake_case (_foo_bar) or
# PascalCase constants (CardInstance).
class-load-variable-name: "_[a-z][a-z0-9_]*|[A-Z][a-zA-Z0-9]*"

function-variable-name: "_?[a-z][a-z0-9_]*"
function-preload-variable-name: "_?[A-Z][a-zA-Z0-9]*"
function-load-variable-name: "_?[A-Z][a-zA-Z0-9]*"

# Leading underscore is allowed on private constants (_POOL_SIZE).
constant-name: "_?[A-Z][A-Z0-9_]*"

# CLAUDE.md mandates `const _BaseOverlay = preload(...)` over bare class_name
# references, so preload constants are private PascalCase (_SpriteRegistry) as
# well as SCREAMING_SNAKE (_C_ARCANE_SEAL) and plain PascalCase (CardInstance).
load-constant-name: "_?[A-Z][A-Za-z0-9_]*"
enum-name: "[A-Z][a-zA-Z0-9]*"
enum-element-name: "[A-Z][A-Z0-9_]*"
