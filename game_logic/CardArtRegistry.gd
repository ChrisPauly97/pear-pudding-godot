const _CARD_SCARAB            := preload("res://assets/textures/cards/card_scarab.png")
const _CARD_SCARAB_SWARM      := preload("res://assets/textures/cards/card_scarab_swarm.png")
const _CARD_BARROW_KING       := preload("res://assets/textures/cards/card_barrow_king.png")
const _CARD_BOG_HAG           := preload("res://assets/textures/cards/card_bog_hag.png")
const _CARD_EMBER_CULTIST     := preload("res://assets/textures/cards/card_ember_cultist.png")
const _CARD_RIFT_ECHO         := preload("res://assets/textures/cards/card_rift_echo.png")
const _CARD_SCOUT             := preload("res://assets/textures/cards/card_scout.png")
const _CARD_RAIDER            := preload("res://assets/textures/cards/card_raider.png")
const _CARD_WENDIGO           := preload("res://assets/textures/cards/card_wendigo.png")
const _CARD_WARLEADER         := preload("res://assets/textures/cards/card_warleader.png")
const _CARD_TERROR            := preload("res://assets/textures/cards/card_terror.png")
const _CARD_UNDEAD_ELITE      := preload("res://assets/textures/cards/card_undead_elite.png")
const _CARD_WORM              := preload("res://assets/textures/cards/card_worm.png")
const _CARD_STAG              := preload("res://assets/textures/cards/card_stag.png")
const _CARD_DUELIST           := preload("res://assets/textures/cards/card_duelist.png")
const _CARD_RIVAL             := preload("res://assets/textures/cards/card_rival.png")
const _CARD_MONK              := preload("res://assets/textures/cards/card_monk.png")
const _CARD_HERBALIST         := preload("res://assets/textures/cards/card_herbalist.png")
const _CARD_TRAINER           := preload("res://assets/textures/cards/card_trainer.png")
const _CARD_WARDEN            := preload("res://assets/textures/cards/card_warden.png")
const _CARD_TREANT            := preload("res://assets/textures/cards/card_treant.png")

## Creature card id -> family portrait / rune (GID-151 / TID-640).
const _CARD_ART: Dictionary = {
	"ancient_guardian": _CARD_STAG,
	"ash_arbiter": _CARD_UNDEAD_ELITE,
	"ash_warden": _CARD_WARLEADER,
	"blitz_ghoul": _CARD_GHOUL,
	"dawn_acolyte": _CARD_MONK,
	"dawn_guardian": _CARD_WARDEN,
	"dawn_healer": _CARD_HERBALIST,
	"dawn_paladin": _CARD_TRAINER,
	"duel_crown": _CARD_DUELIST,
	"dusk_seer": _CARD_BOG_HAG,
	"dusk_vampire": _CARD_RIVAL,
	"dusk_wraith": _CARD_GHOST,
	"ember_imp": _CARD_EMBER_CULTIST,
	"iron_revenant": _CARD_TERROR,
	"isfig_shadow_echo": _CARD_RIVAL,
	"phoenix_rise": _RUNE_EMBER,
	"pyre_warden": _CARD_EMBER_CULTIST,
	"scarab": _CARD_SCARAB,
	"shrouded_wraith": _CARD_GHOST,
	"sig_alpha_wolf": _CARD_WOLF,
	"sig_barrow_crown": _CARD_BARROW_KING,
	"sig_cauldron_toad": _CARD_BOG_HAG,
