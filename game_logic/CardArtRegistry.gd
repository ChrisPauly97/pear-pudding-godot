	"sig_echo_shard": _CARD_RIFT_ECHO,
	"sig_pack_leader": _CARD_WOLF_PACK,
	"sig_pathfinder": _CARD_SCOUT,
	"sig_scarab_matriarch": _CARD_SCARAB_SWARM,
	"sig_shambler": _CARD_ZOMBIE,
	"sig_wanderer": _CARD_RAIDER,
	"sig_warlord": _CARD_WARLEADER,
	"sig_wendigo_antler": _CARD_WENDIGO,
	"soul_harvest": _RUNE_DAWN,
	"surge_spirit": _CARD_RIFT_ECHO,
	"time_warp": _RUNE_FLUX,
	"treant": _CARD_TREANT,
	"veiled_paladin": _CARD_DUELIST,
	"void_creeper": _CARD_WORM,
	"void_wyrm": _CARD_TERROR,
	"wolf": _CARD_WOLF,
}

## Maps a card illustration key + magic branch to its texture.
## illus_key is a card id (minions / legendaries, via _CARD_ART) or "spell"
## (any non-creature key) for spell cards, which route by magic_branch
## instead. Returns null for an unrecognized key/branch combination —
## caller falls back to TextureGen.card_illustration().
static func illustration(illus_key: String, magic_branch: String) -> Texture2D:
	match illus_key:
		"ghost":    return _CARD_GHOST
		"skeleton": return _CARD_SKELETON
		"zombie":   return _CARD_ZOMBIE
		"ghoul":    return _CARD_GHOUL
	if _CARD_ART.has(illus_key):
		return _CARD_ART[illus_key] as Texture2D
	match magic_branch:
		"dawn":  return _RUNE_DAWN
		"dusk":  return _RUNE_DUSK
		"ember": return _RUNE_EMBER
		"ash":   return _RUNE_ASH
		"bloom": return _RUNE_BLOOM
		"thorn": return _RUNE_THORN
		"flux":  return _RUNE_FLUX
		"fracture": return _RUNE_FRACTURE
	return null
